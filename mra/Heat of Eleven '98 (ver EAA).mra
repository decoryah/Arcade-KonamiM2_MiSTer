<misterromdescription>
    <name>Heat of Eleven '98 (ver EAA)</name>
    <setname>heatof11</setname>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Konami</manufacturer>
    <rbf>KonamiM2Heat</rbf>
    <!-- the buttons as the game's guides name them -->
    <buttons names="Pass/Tackle/Lifting,Long/Sliding/H.Lift,Shift,Start,Coin,Pause,Step" default="A,B,X,Start,Select,R,L" />

    <!--
      Heat of Eleven's own build (KonamiM2.qsf's Heat of Eleven lines, its Z buffer in the SDRAM board's memory), as
      KonamiM2Heat_<date>.rbf in _Arcade/cores: not KonamiM2_..., which the other MRAs' "KonamiM2" would also find.

      As Tobe! Polystars' MRA, with the 636a01 boot ROM, RAM 2 x 8 MB and an M48T58 (dallas.5e): index 3 is its 8 KB, then
      a byte for the board, whose bit 0 asks for the larger RAM. The core shows the game's low resolution.

      heatof11_cd.zip and heatof11_full.bin aren't in a MAME set: make them from the set's 703eaa02.chd with
      python3 tools/m2disc.py heatof11/703eaa02.chd or the browser converter (https://konami-m2-chd-converter.fueledmyrrh2.chatgpt.site/), and put heatof11_cd.zip (25 MB in it) beside heatof11.zip and
      heatof11_full.bin (315 MB, the music streams from it) in games/heatof11.
    -->

    <file delay="1" type="s" index="0" path="heatof11_full.bin"/>

    <rom index="0" zip="heatof11.zip" md5="964a0026327759767647049c30781af6" address="0x30000000">
        <part name="636a01.8q" crc="7b1dc738"/>
    </rom>
    <rom index="1" zip="heatof11_cd.zip" md5="none" address="0x32000000">
        <part name="heatof11_cd.bin"/>
    </rom>
    <rom index="2" zip="heatof11.zip" md5="none">
        <part name="93c46.7k"/>
    </rom>

    <rom index="3" zip="heatof11.zip" md5="none">
        <part name="dallas.5e"/>
        <part>01</part>
    </rom>
    <!-- the EEPROM (the service menu's settings) and the M48T58's 8 KB (the tournament settings, the clock's offset): Main saves
         them in one file (nvram/) and loads it, after both, in place of the set's 93c46.7k and dallas.5e -->
    <nvram index="2" size="8320"/>
</misterromdescription>
